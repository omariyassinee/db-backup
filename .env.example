# PostgreSQL Connection URL (for Neon, use the direct/unpooled connection string)
DATABASE_ROOT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Output directory for backup archives (defaults to backup/db)
BACKUP_DIR="./backup/db"

# Automatic Retention Policy (days or count)
BACKUP_RETENTION_DAYS=14
# BACKUP_RETENTION_COUNT=10

# Optional: Dead Man's Switch Monitoring (Healthchecks.io, Cronitor)
# Pings /start on begin, / on success, /fail on failure
# BACKUP_PING_URL="https://hc-ping.com/your-uuid-here"

# Optional: Webhook Alert (Discord, Slack, or generic JSON endpoint)
# BACKUP_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Optional: Telegram Notifications & Bot Daemon
# BACKUP_TELEGRAM_TOKEN="123456789:AA..."
# BACKUP_TELEGRAM_CHAT_ID="123456789"
# BACKUP_TELEGRAM_THREAD_ID=42
# BACKUP_TELEGRAM_SEND_FILES=true
